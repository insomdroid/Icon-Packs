<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_pack"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <meta-data android:name="com.anddoes.launcher.THEME" android:resource="@xml/appfilter" />
        <meta-data android:name="com.teslacoilsw.launcher.THEME" android:resource="@xml/appfilter" />
        <meta-data android:name="com.actionlauncher.THEME" android:resource="@xml/appfilter" />
        <meta-data android:name="app.lawnchair.THEME" android:resource="@xml/appfilter" />

        <activity
            android:name=".PackInfoActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter><action android:name="org.adw.ActivityStarter.THEMES" /></intent-filter>
            <intent-filter><action android:name="com.novalauncher.THEME" /></intent-filter>
            <intent-filter><action android:name="com.anddoes.launcher.THEME" /></intent-filter>
            <intent-filter><action android:name="com.teslacoilsw.launcher.THEME" /></intent-filter>
            <intent-filter><action android:name="com.actionlauncher.THEME" /></intent-filter>
        </activity>

        <activity
            android:name=".widget.KitKatGalleryWidgetConfigureActivity"
            android:exported="true"
            android:label="@string/gallery_widget_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service android:name=".widget.KitKatMusicNotificationListener" android:label="@string/music_widget_name" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:exported="true">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>

        <receiver android:name=".widget.KitKatCalendarWidgetProvider" android:exported="true" android:label="@string/calendar_widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/kitkat_calendar_widget_info" />
        </receiver>

        <receiver android:name=".widget.KitKatDigitalClockWidgetProvider" android:exported="true" android:label="@string/digital_clock_widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="android.intent.action.TIME_TICK" /><action android:name="android.intent.action.TIME_CHANGED" /><action android:name="android.intent.action.TIMEZONE_CHANGED" /><action android:name="android.intent.action.DATE_CHANGED" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/kitkat_digital_clock_widget_info" />
        </receiver>

        <receiver android:name=".widget.KitKatSearchWidgetProvider" android:exported="true" android:label="@string/search_widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/kitkat_search_widget_info" />
        </receiver>

        <receiver android:name=".widget.KitKatMusicWidgetProvider" android:exported="true" android:label="@string/music_widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/kitkat_music_widget_info" />
        </receiver>

        <receiver android:name=".widget.KitKatGalleryWidgetProvider" android:exported="true" android:label="@string/gallery_widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/kitkat_gallery_widget_info" />
        </receiver>

        <receiver android:name=".widget.KitKatPowerWidgetProvider" android:exported="true" android:label="@string/power_widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/kitkat_power_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.KitKatClockWidgetProvider"
            android:exported="true"
            android:label="@string/kitkat_clock_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_TICK" />
                <action android:name="android.intent.action.TIME_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kitkat_clock_widget_info" />
        </receiver>
    </application>
</manifest>
