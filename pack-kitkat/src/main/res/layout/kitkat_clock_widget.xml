<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">
    <ImageView
        android:id="@+id/clock_dial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/kitkat_clock_widget_name"
        android:scaleType="fitCenter"
        android:src="@drawable/kitkat_clock_dial" />
    <ImageView
        android:id="@+id/clock_hour"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/kitkat_clock_hour" />
    <ImageView
        android:id="@+id/clock_minute"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/kitkat_clock_minute" />
    <TextView
        android:id="@+id/clock_digital"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="4dp"
        android:background="#B3000000"
        android:fontFamily="@font.kitkat_clock_mono_light"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="normal" />
</FrameLayout>